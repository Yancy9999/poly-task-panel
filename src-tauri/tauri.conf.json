{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PolyTaskPanel",
  "version": "2.4.0",
  "identifier": "com.polytask.panel",
  "build": {
    "frontendDist": "../public"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "resources": {
      "../server.js": "server.js",
      "../package.json": "package.json",
      "../ABOUT.md": "ABOUT.md",
      "../public": "public",
      "../node_modules": "node_modules",
      "bundled-node": "bundled-node"
    },
    "windows": {
      "allowDowngrades": true,
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese"]
      },
      "wix": {
        "language": ["zh-CN"]
      }
    }
  }
}
